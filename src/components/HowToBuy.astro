---
import { Search, ShoppingBag, ClipboardList, MessageCircle, Truck } from "@lucide/astro";
import { siteConfig } from "@/lib/config";

const steps = [
  {
    icon: Search,
    title: "Explora el catalogo",
    text: "Mira los productos en la pagina, en nuestro catalogo de WhatsApp o en Instagram.",
  },
  {
    icon: ShoppingBag,
    title: "Agrega al carrito",
    text: "Elige los productos y las cantidades que quieras. Podes pedir varios a la vez.",
  },
  {
    icon: ClipboardList,
    title: "Completa tus datos",
    text: "Nombre, correo, direccion y ciudad, para coordinar tu envio.",
  },
  {
    icon: MessageCircle,
    title: "Confirmamos por WhatsApp",
    text: "Te escribimos para confirmar disponibilidad y el medio de pago: Nequi, Daviplata, Llave Bre-B o contraentrega.",
  },
  {
    icon: Truck,
    title: "Recibe tu pedido",
    text: "Coordinamos el envio a tu ciudad. Gratis en compras desde $150.000.",
  },
];
---

<section class="border-t border-black/5 bg-white py-16 sm:py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-wide text-brand-600">Como funciona</p>
      <h2 class="mt-2 text-2xl font-bold text-ink-900 sm:text-3xl">Como comprar en {siteConfig.name}</h2>
      <p class="mt-3 text-sm text-ink-700 sm:text-base">
        Sin pagos en linea ni registros: armas tu pedido y cerramos todo por WhatsApp.
      </p>
    </div>

    <div class="relative mt-12">

      <ol class="relative grid gap-10 sm:grid-cols-5 sm:gap-6">
        {
          steps.map((step, i) => (
            <li class="flex flex-col items-center text-center">
              <div class="relative flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-500 text-white shadow-sm">
                <step.icon class="h-5 w-5" />
                <span class="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full bg-ink-900 text-[10px] font-bold text-white">
                  {i + 1}
                </span>
              </div>
              <p class="mt-4 font-semibold text-ink-900">{step.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-700">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-12 text-center">
      <a href="/catalogo" class="btn-primary">
        Empezar a comprar
      </a>
    </div>
  </div>
</section>
