---
import AddToCartButton from "@/components/cart/AddToCartButton";
import { siteConfig } from "@/lib/config";
import { getDiscountPercent } from "@/lib/product";

interface Props {
  slug: string;
  name: string;
  price: number;
  salePrice?: number | null;
  image: string;
  imageAlt?: string;
  category: string;
  inStock: boolean;
  weeklyDeal: boolean;
}

const { slug, name, price, salePrice, image, imageAlt, category, inStock, weeklyDeal } = Astro.props;
const discount = getDiscountPercent(price, salePrice ?? null)
const hasDiscount = !!salePrice;

const formatter = new Intl.NumberFormat(siteConfig.locale, {
  style: "currency",
  currency: siteConfig.currency,
  maximumFractionDigits: 0,
});
---

<article class="card relative group flex flex-col overflow-hidden" data-category={category}>

  {/* Etiqueta de descuento: rojo (universal para "oferta/rebaja" en
      e-commerce, y contrasta mejor que el naranja de marca, que ya se usa
      en los botones de compra) en forma de pill, no circulo, para que no
      se vea apretada con porcentajes de 2-3 digitos (ej. "-100%"). */}
  {hasDiscount &&
    <span class="absolute left-3 top-3 z-10 rounded-full bg-red-600 px-2.5 py-1 text-xs font-bold text-white shadow-sm">
      -{discount}%
    </span>
  }

  <a href={`/producto/${slug}`} class="relative block aspect-square overflow-hidden bg-black/5">
    <img
      src={image}
      alt={imageAlt || name}
      loading="lazy"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
    />
    {
      !inStock && (
        <span class="absolute right-3 top-3 rounded-full bg-ink-900/90 px-3 py-1 text-xs font-semibold text-white">
          Agotado
        </span>
      )
    }
  </a>

  <div class="flex flex-1 flex-col gap-2 p-4 justify-between">
    <div>
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">{category}</p>
    <a href={`/producto/${slug}`} class="font-semibold text-ink-900 hover:text-brand-600">
      {name}
    </a>

    <div class="mt-1 flex items-baseline gap-2">
      <span class="text-lg font-bold text-ink-900">{formatter.format(salePrice ?? price)}</span>
      {
        salePrice && (
          <span class="text-sm text-slate-400 line-through">{formatter.format(price)}</span>
        )
      }
    </div>
    </div>

    <div class="mt-3 flex items-center gap-2">
      <AddToCartButton client:visible product={{ slug, name, price, image, inStock, salePrice }} variant="block" />
    </div>
  </div>
</article>
