---
import { MessageCircle } from "@lucide/astro";
import InstagramIcon from "@/components/icons/InstagramIcon.astro";
import { siteConfig } from "@/lib/config";
import { buildWhatsAppLink, generalWhatsAppMessage } from "@/lib/whatsapp";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-black/5 bg-white">
  <div class="container-page grid gap-8 py-12 sm:grid-cols-3">
    <div>
      <p class="text-lg font-extrabold text-ink-900">{siteConfig.name}</p>
      <p class="mt-2 text-sm text-ink-700">{siteConfig.tagline}</p>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-900">Comprar</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        <li><a href="/catalogo" class="hover:text-brand-600">Ver catalogo</a></li>
        <li>
          <a href={siteConfig.whatsappCatalogUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-600">
            Catalogo de WhatsApp
          </a>
        </li>
        <li>
          <a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-600">
            Instagram
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-900">Contacto</p>
      <div class="mt-3 flex gap-3">
        <a
          href={buildWhatsAppLink(generalWhatsAppMessage())}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="text-ink-700 transition hover:text-[#25D366]"
        >
          <MessageCircle class="h-5 w-5" />
        </a>
        <a
          href={siteConfig.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-ink-700 transition hover:text-brand-600"
        >
          <InstagramIcon class="h-5 w-5" />
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-black/5 py-6 text-center text-xs text-ink-700">
    © {year} {siteConfig.name}. Todos los derechos reservados.
  </div>
</footer>
