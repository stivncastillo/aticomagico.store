---
import { getImage } from "astro:assets";
import HeroCarousel from "@/components/HeroCarousel";
import { heroSlides } from "@/lib/heroSlides";

// Cada imagen del hero pasa por el mismo pipeline de optimizacion que
// antes (webp, calidad 80, 900x600) - solo que ahora se resuelve aca,
// en el frontmatter de Astro, porque el carousel en si (que cambia de
// imagen/titulo/texto cada 5s, con flechas y puntos) es una isla de
// React (HeroCarousel.tsx) y adentro de React no se puede usar
// <Image>/astro:assets directamente.
const slides = await Promise.all(
  heroSlides.map(async (slide) => {
    const optimized = await getImage({
      src: slide.image,
      width: 900,
      height: 600,
      format: "webp",
      quality: 80,
    });
    return {
      image: { src: optimized.src, width: 900, height: 600 },
      alt: slide.alt,
      title: slide.title,
      description: slide.description,
      ctaLabel: slide.ctaLabel,
      ctaHref: slide.ctaHref,
    };
  })
);
---

<section class="border-b border-black/5 bg-linear-to-b from-brand-100 to-transparent">
  <div class="container-page py-16 sm:py-24">
    <HeroCarousel client:load slides={slides} />
  </div>
</section>
