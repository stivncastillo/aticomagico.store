---
import { Image } from "astro:assets";
import { MessageCircle } from "@lucide/astro";
import { siteConfig } from "@/lib/config";
import { buildWhatsAppLink, generalWhatsAppMessage } from "@/lib/whatsapp";
import heroImage from "@/assets/hero.png";
---

<section class="border-b border-black/5 bg-linear-to-b from-brand-100 to-transparent">
  <div class="container-page grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-2">
    <div>
      <h1 class="text-4xl font-extrabold tracking-tight text-ink-900 sm:text-5xl">
        {siteConfig.tagline}
      </h1>
      <p class="mt-4 max-w-md text-base text-ink-700 sm:text-lg">
        {siteConfig.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/catalogo" class="btn-primary">
          Ver catalogo
        </a>
        <a
          href={buildWhatsAppLink(generalWhatsAppMessage())}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
        >
          <MessageCircle class="h-4 w-4" />
          Escribir por WhatsApp
        </a>
      </div>
    </div>

    <div class="mx-auto w-full max-w-md overflow-hidden rounded-3xl shadow-lg shadow-brand-900/10 lg:max-w-none">
      <Image
        src={heroImage}
        alt={siteConfig.tagline}
        width={900}
        height={600}
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
        class="aspect-3/2 h-full w-full object-cover"
      />
    </div>
  </div>
</section>
