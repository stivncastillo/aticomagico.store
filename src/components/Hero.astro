---
import { MessageCircle, Package } from "@lucide/astro";
import { siteConfig } from "@/lib/config";
import { buildWhatsAppLink, generalWhatsAppMessage } from "@/lib/whatsapp";
---

<section class="border-b border-black/5 bg-linear-to-b from-brand-100 to-transparent">
  <div class="container-page grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-2">
    <div>
      <h1 class="text-4xl font-extrabold tracking-tight text-ink-900 sm:text-5xl">
        {siteConfig.tagline}
      </h1>
      <p class="mt-4 max-w-md text-base text-ink-700 sm:text-lg">
        {siteConfig.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/catalogo" class="btn-primary">
          Ver catálogo
        </a>
        <a
          href={buildWhatsAppLink(generalWhatsAppMessage())}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
        >
          <MessageCircle class="h-4 w-4" />
          Escribir por WhatsApp
        </a>
      </div>
    </div>

    <div class="relative mx-auto flex aspect-3/2 w-full max-w-md items-center justify-center overflow-hidden rounded-3xl bg-linear-to-br from-brand-400 to-brand-700 shadow-lg shadow-brand-900/10 lg:max-w-none">
      <div class="absolute -left-8 -top-8 h-28 w-28 rounded-full bg-white/10" aria-hidden="true"></div>
      <div class="absolute -right-10 -bottom-10 h-36 w-36 rounded-full bg-white/10" aria-hidden="true"></div>
      <Package class="h-24 w-24 text-white/90 sm:h-28 sm:w-28" stroke-width={1.5} />
    </div>
  </div>
</section>
