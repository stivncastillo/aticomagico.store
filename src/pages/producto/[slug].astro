---
import { getCollection, render } from "astro:content";
import { MessageCircle, ArrowLeft } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import { siteConfig } from "@/lib/config";
import { buildWhatsAppLink, productWhatsAppMessage } from "@/lib/whatsapp";
import AddToCartButton from "@/components/cart/AddToCartButton";
import ProductGallery from "@/components/ProductGallery";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { data } = product;

const allProducts = await getCollection("products");
const related = allProducts
  .filter((p) => p.id !== product.id && p.data.category === data.category)
  .slice(0, 4);

const formatter = new Intl.NumberFormat(siteConfig.locale, {
  style: "currency",
  currency: siteConfig.currency,
  maximumFractionDigits: 0,
});
---

<Layout title={data.name} description={data.description} image={data.image}>
  <section class="container-page py-10 sm:py-16">
    <a href="/catalogo" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-700 hover:text-brand-600">
      <ArrowLeft class="h-4 w-4" />
      Volver al catalogo
    </a>

    <div class="mt-6 grid gap-10 lg:grid-cols-2">
      <ProductGallery
        client:load
        images={data.images && data.images.length > 0 ? data.images : [data.image]}
        alt={data.imageAlt || data.name}
      />

      <div>
        <p class="text-xs font-medium uppercase tracking-wide text-brand-600">{data.category}</p>
        <h1 class="mt-2 text-3xl font-extrabold text-ink-900 sm:text-4xl">{data.name}</h1>

        <div class="mt-4 flex items-baseline gap-3">
          <span class="text-2xl font-bold text-ink-900">{formatter.format(data.price)}</span>
          {
            data.compareAtPrice && (
              <span class="text-lg text-ink-700 line-through">{formatter.format(data.compareAtPrice)}</span>
            )
          }
        </div>

        <p class="mt-6 leading-relaxed text-ink-700">{data.description}</p>

        {
          !data.inStock && (
            <p class="mt-4 inline-block rounded-full bg-ink-900/90 px-3 py-1 text-xs font-semibold text-white">
              Agotado por ahora
            </p>
          )
        }

        <a
          href={buildWhatsAppLink(productWhatsAppMessage(data.name))}
          target="_blank"
          rel="noopener noreferrer"
          class:list={["btn-whatsapp mt-8 w-full sm:w-auto", !data.inStock && "pointer-events-none opacity-40"]}
        >
          <MessageCircle class="h-5 w-5" />
          Comprar por WhatsApp
        </a>

        <p class="mt-3 text-xs text-ink-700">
          Al hacer clic se abre WhatsApp con un mensaje ya escrito para agilizar tu compra.
        </p>

        <div class="mt-2 border-t border-black/5 pt-2">
          <p class="mt-4 text-sm text-ink-700">
            ¿Vas a pedir mas de un producto? Agregalo al carrito y cierra todo el pedido junto.
          </p>
          <AddToCartButton
            client:load
            product={{ slug: product.id, name: data.name, price: data.price, image: data.image, inStock: data.inStock }}
            variant="full"
          />
        </div>
      </div>
    </div>

    {
      related.length > 0 && (
        <div class="mt-20">
          <h2 class="text-xl font-bold text-ink-900">Tambien te puede gustar</h2>
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
            {related.map((p) => (
              <ProductCard
                slug={p.id}
                name={p.data.name}
                price={p.data.price}
                compareAtPrice={p.data.compareAtPrice}
                image={p.data.image}
                imageAlt={p.data.imageAlt}
                category={p.data.category}
                inStock={p.data.inStock}
              />
            ))}
          </div>
        </div>
      )
    }
  </section>
</Layout>
