---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import HowToBuy from "@/components/HowToBuy.astro";
import ProductCard from "@/components/ProductCard.astro";
import { siteConfig } from "@/lib/config";

const allProducts = await getCollection("products");
const featured = allProducts.filter((p) => p.data.featured).slice(0, 8);
---

<Layout title={siteConfig.name}>
  <Hero />

  <section class="container-page py-16 sm:py-24">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-bold text-ink-900 sm:text-3xl">Destacados</h2>
      <a href="/catalogo" class="text-sm font-semibold text-brand-600 hover:underline">
        Ver todo →
      </a>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
      {
        featured.map((product) => (
          <ProductCard
            slug={product.id}
            name={product.data.name}
            price={product.data.price}
            compareAtPrice={product.data.compareAtPrice}
            image={product.data.image}
            imageAlt={product.data.imageAlt}
            category={product.data.category}
            inStock={product.data.inStock}
          />
        ))
      }
    </div>
  </section>

  <HowToBuy />

</Layout>
