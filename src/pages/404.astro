---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Pagina no encontrada">
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="text-6xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 text-2xl font-bold text-ink-900">Esta pagina se perdio en el camino</h1>
    <p class="mt-2 text-ink-700">Puede que el producto ya se haya ido, o el link este vencido.</p>
    <a href="/" class="btn-secondary mt-6">Volver al inicio</a>
  </section>
</Layout>
